{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.indianservers.com/edtech/schemas/mcq-question-v1.json",
  "title": "Indian Servers MCQ Question v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "subject",
    "language",
    "level",
    "category",
    "subcategory",
    "conceptId",
    "concept",
    "difficulty",
    "cognitiveLevel",
    "type",
    "question",
    "options",
    "correctOptionId",
    "explanation",
    "optionExplanations",
    "hint",
    "relatedConcepts",
    "syllabusReferences",
    "tags",
    "estimatedSeconds",
    "shuffleOptions",
    "status",
    "revision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{5,119}$"
    },
    "schemaVersion": {
      "const": 1
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "level": {
      "enum": ["school", "undergraduate", "postgraduate"]
    },
    "class": {
      "type": ["integer", "null"],
      "minimum": 6,
      "maximum": 12
    },
    "category": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "subcategory": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "conceptId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"
    },
    "concept": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "difficulty": {
      "enum": ["foundational", "intermediate", "advanced", "challenge"]
    },
    "cognitiveLevel": {
      "enum": [
        "recall",
        "understanding",
        "application",
        "analysis",
        "calculation",
        "data_interpretation",
        "experimental_reasoning",
        "mechanism",
        "advanced_reasoning"
      ]
    },
    "type": {
      "const": "single_choice"
    },
    "question": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1500
    },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,20}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          }
        }
      }
    },
    "correctOptionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "explanation": {
      "type": "string",
      "minLength": 40,
      "maxLength": 4000
    },
    "optionExplanations": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "additionalProperties": {
        "type": "string",
        "minLength": 12,
        "maxLength": 1500
      }
    },
    "hint": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1000
    },
    "formula": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "relatedConcepts": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"
      }
    },
    "syllabusReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "level", "unit"],
        "properties": {
          "framework": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "level": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "unit": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
      }
    },
    "estimatedSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 3600
    },
    "shuffleOptions": {
      "type": "boolean"
    },
    "status": {
      "const": "published"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "alt"],
      "properties": {
        "type": {
          "const": "image"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9._/-]+$"
        },
        "alt": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "level": {
            "const": "school"
          }
        }
      },
      "then": {
        "required": ["class"]
      },
      "else": {
        "properties": {
          "class": {
            "type": "null"
          }
        }
      }
    }
  ]
}
